{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/defold-opencode.md"],
  "lsp": {
    "lua-ls": {
      "command": ["lua-language-server"],
      "extensions": [
        ".lua",
        ".script",
        ".gui_script",
        ".render_script",
        ".editor_script"
      ]
    }
  },
  "permission": {
    "edit": {
      "*": "allow",
      "**/.deps/**": "deny",
      "**/build/**": "deny",
      "**/.internal/**": "deny"
    }
  },
  "watcher": {
    "ignore": [
      "build/**",
      ".internal/**",
      ".deps/**"
    ]
  }
}
