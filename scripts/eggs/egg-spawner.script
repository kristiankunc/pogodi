local board = require("scripts.board")

local POSITION_OFFSET = vmath.vector3(120, 40, 0)
local SPAWN_INTERVAL = 2.0

function init(self)
	self.origin = go.get_position()
	self.spawn_timer = 0
end

function update(self, dt)
	self.spawn_timer = self.spawn_timer + dt
	if self.spawn_timer >= SPAWN_INTERVAL then
		self.spawn_timer = 0
		spawn_egg(self)
	end
end

-- selene: allow(unused_variable) -- called from update() above, defined after due to Defold callback ordering
function spawn_egg(self)
	local corner = board.CORNER_KEYS[math.random(#board.CORNER_KEYS)]
	local target_position = board.position(self.origin, corner)
	local side = board.OFFSETS[corner].x
	local spawn_position =
		vmath.vector3(target_position.x + POSITION_OFFSET.x * side, target_position.y + POSITION_OFFSET.y, 0)
	local roll_duration_ms = math.random(1000, 3000)
	factory.create("#egg_factory", nil, nil, {
		spawn_position = spawn_position,
		target_position = target_position,
		roll_duration_ms = roll_duration_ms,
	})
end
