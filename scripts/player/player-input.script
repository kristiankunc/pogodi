local board = require("scripts.board")

local INPUT_KEYS = {
	up = hash("up"),
	down = hash("down"),
	left = hash("left"),
	right = hash("right"),
}

function init(self)
	msg.post(".", "acquire_input_focus")
	self.vertical = "n"
	self.horizontal = "w"
	self.origin = go.get_position()
	update_position(self)
end

function on_input(self, action_id, action)
	if not action.pressed then
		return
	end

	if action_id == INPUT_KEYS.up then
		self.vertical = "n"
	elseif action_id == INPUT_KEYS.down then
		self.vertical = "s"
	elseif action_id == INPUT_KEYS.left then
		self.horizontal = "w"
	elseif action_id == INPUT_KEYS.right then
		self.horizontal = "e"
	else
		return
	end

	update_position(self)
end

-- selene: allow(unused_variable) -- called from init()/on_input() above, defined after due to Defold callback ordering
function update_position(self)
	go.set_position(board.position(self.origin, self.vertical .. self.horizontal))
end
