[bootstrap]
main_collection = /main/collections/main-menu.collectionc

[script]
shared_state = 1

[display]
width = 960
height = 640
high_dpi = 1

[input]
game_binding = /input/game.input_bindingc

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01

[html5]
scale_mode = stretch

[project]
title = nu-pogodi
dependencies#0 = https://github.com/britzl/gooey/archive/master.zip
dependencies#1 = https://github.com/whiteboxdev/library-defold-colors/archive/master.zip

